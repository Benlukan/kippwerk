+    // KIPPWERK-Patch: Top-Liste + eigene Platzierung laden (für die Anzeige im Spiel)
+    func loadTop(_ call: CAPPluginCall) {
+        guard let leaderboardID = call.getString("leaderboardId") else {
+            call.reject("missing leaderboardId"); return
+        }
+        let count = Swift.min(25, Swift.max(1, call.getInt("maxResults") ?? 5))
+        let scope: GKLeaderboard.TimeScope
+        switch call.getString("timeSpan") {
+        case "day": scope = .today
+        case "week": scope = .week
+        default: scope = .allTime
+        }
+        GKLeaderboard.loadLeaderboards(IDs: [leaderboardID]) { boards, error in
+            if let error = error { call.reject(error.localizedDescription, nil, error); return }
+            guard let board = boards?.first else { call.reject("leaderboard not found"); return }
+            board.loadEntries(for: .global, timeScope: scope, range: NSRange(location: 1, length: count)) { local, entries, _, err in
+                if let err = err { call.reject(err.localizedDescription, nil, err); return }
+                var list: [[String: Any]] = []
+                for e in entries ?? [] {
+                    list.append(["rank": e.rank, "name": e.player.displayName, "score": e.score, "playerId": e.player.gamePlayerID])
+                }
+                var result: [String: Any] = ["entries": list]
+                if let me = local {
+                    result["me"] = ["rank": me.rank, "score": me.score, "playerId": me.player.gamePlayerID]
+                }
+                call.resolve(result)
+            }
+        }
+    }
